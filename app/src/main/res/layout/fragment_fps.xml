<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tvFpsResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- FPS"
        android:textColor="@color/neon_pink_soft"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFpsNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Chưa đo"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnMeasureFps"
        style="@style/LumiButton"
        android:layout_marginTop="28dp"
        android:text="Đo FPS ngay" />

</LinearLayout>
