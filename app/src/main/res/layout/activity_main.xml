<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="FPS Vietnamese logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="FPS VIETNAMESE"
        android:textColor="@color/text_light"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:text="Đối tác sáng tạo Free Fire — tối ưu hiệu năng"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:text="Trạng thái Shizuku: chưa kiểm tra"
        android:textColor="@color/text_dim"
        android:textSize="14sp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnRequestPermission"
        style="@style/LumiButton"
        android:text="Xin quyền Shizuku" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="6dp"
        android:text="TỐI ƯU FPS — CẦN SHIZUKU"
        android:textColor="@color/neon_pink_soft"
        android:textSize="12sp"
        android:letterSpacing="0.15" />

    <Button
        android:id="@+id/btnQuickFix"
        style="@style/LumiButton"
        android:text="⚡ Fix Lag FPS (1 chạm)" />

    <Button
        android:id="@+id/btnBoostScreen"
        style="@style/LumiButton"
        android:layout_marginTop="12dp"
        android:text="📺 Buff Màn" />

    <Button
        android:id="@+id/btnCleanRam"
        style="@style/LumiButton"
        android:layout_marginTop="12dp"
        android:text="🧹 Dọn RAM" />

    <Button
        android:id="@+id/btnClearCache"
        style="@style/LumiButton"
        android:layout_marginTop="12dp"
        android:text="Xoá cache (chọn app)" />

    <Button
        android:id="@+id/btnOptimize"
        style="@style/LumiButton"
        android:layout_marginTop="12dp"
        android:text="Tắt animation hệ thống" />

    <Button
        android:id="@+id/btnDpi"
        style="@style/LumiButton"
        android:layout_marginTop="12dp"
        android:text="Chỉnh DPI màn hình" />

    <Button
        android:id="@+id/btnGameMode"
        style="@style/LumiButton"
        android:layout_marginTop="12dp"
        android:text="Bật Game Mode hiệu năng" />

    <Button
        android:id="@+id/btnSustainedPerf"
        style="@style/LumiButton"
        android:layout_marginTop="12dp"
        android:text="Bật hiệu năng ổn định" />

    <Button
        android:id="@+id/btnBatterySaver"
        style="@style/LumiButton"
        android:layout_marginTop="12dp"
        android:text="Tắt tiết kiệm pin tạm thời" />

    <Button
        android:id="@+id/btnGpuRender"
        style="@style/LumiButton"
        android:layout_marginTop="12dp"
        android:text="Ép vẽ bằng GPU" />

    <Button
        android:id="@+id/btnComboBoost"
        style="@style/LumiButton"
        android:layout_marginTop="12dp"
        android:text="🔥 Bật Combo Boost" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="6dp"
        android:text="NHẬT KÝ HOẠT ĐỘNG"
        android:textColor="@color/neon_pink_soft"
        android:textSize="12sp"
        android:letterSpacing="0.2" />

    <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_log"
        android:padding="14dp"
        android:text="Sẵn sàng."
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:scrollbars="vertical" />

</LinearLayout>
</ScrollView>
