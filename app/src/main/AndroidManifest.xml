<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cần để đọc file addon người dùng chọn (chọn qua file picker, không cần MANAGE_EXTERNAL_STORAGE) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:label="Lumi Addons FPS"
        android:theme="@style/Theme.AppCompat.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Provider bắt buộc để Shizuku hoạt động trên Android < 13.
          authorities PHẢI trùng package name của app + ".shizuku"
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.lumi.fpsaddons.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
